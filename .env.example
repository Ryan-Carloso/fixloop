# Copy to .env and fill in. Never commit .env.
FIXLOOP_PORT=3000
FIXLOOP_HOST=0.0.0.0

# Shared secret protecting POST /webhooks/bugsink.
# BugSink signs nothing, so callers must send this as
# X-FixLoop-Webhook-Token header (or ?token= query param).
FIXLOOP_WEBHOOK_SECRET=change-me

# Token used to push autofix branches and open PRs.
# Local dev: a fine-grained PAT. Production: a GitHub App installation token.
GITHUB_TOKEN=

# Model OpenCode should use inside job containers, e.g. "opencode/big-pickle".
OPENCODE_MODEL=

# Job execution limits
FIXLOOP_JOB_TIMEOUT=1800
FIXLOOP_CPU_LIMIT=2
FIXLOOP_MEMORY_LIMIT=4g
FIXLOOP_PIDS_LIMIT=512
